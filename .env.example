# Banco PostgreSQL
DATABASE_URL="postgresql://awake:awake_dev@localhost:5432/awake?schema=public"
# URL pública da aplicação (usada em links de convite/recuperação)
APP_URL="http://localhost:3000"
# Diretório de uploads (fora de /public; arquivos servidos apenas via rota autenticada)
UPLOAD_DIR="./uploads"
# Tamanho máximo de upload em MB
UPLOAD_MAX_MB="15"
# "disk" (padrão, usa UPLOAD_DIR) ou "db" (guarda os arquivos no PostgreSQL — use em hospedagens sem disco persistente, como o Render gratuito)
STORAGE_DRIVER="disk"
# Senha dos usuários demonstrativos do seed (obrigatória para semear; não use em produção)
SEED_DEMO_PASSWORD=""
# SMTP opcional para convites e recuperação de senha. Sem SMTP, os links são exibidos ao administrador/registrados no log do servidor.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Campaign Forge <no-reply@example.com>"
